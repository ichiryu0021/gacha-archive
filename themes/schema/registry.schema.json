{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gacha-archive.local/registry.schema.json",
  "title": "二游档案主题注册表",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interfaceVersion",
    "defaultTheme",
    "themes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "interfaceVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "defaultTheme": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "directory"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "directory": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    }
  }
}
