{
  "name": "miyou-archive",
  "version": "1.0.2",
  "private": true,
  "description": "米哈游五星抽卡本地档案：自动读链、官方同步、截图补录、图鉴与自动更新",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "desktop": "node scripts/desktop.cjs",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/core.test.mjs",
    "pack": "electron-packager . \"米游档案\" --platform=win32 --arch=x64 --out=dist --overwrite --asar=false --icon=public/icon.ico --ignore=dist --ignore=docs --ignore=tests --ignore=data/app.json --ignore=data/uploads --ignore=data/assets --ignore=scripts/pooltable.snippet.txt"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.3.4"
  },
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/ichiryu0021/miyou-archive.git"
  },
  "productName": "米游档案"
}
