{
  "name": "eryou-archive",
  "version": "2.0.0",
  "displayVersion": "2.00",
  "private": true,
  "license": "MIT",
  "description": "二游抽卡记录本地档案：自动读链、官方同步、截图补录、图鉴与自动更新",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "desktop": "node scripts/desktop.cjs",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/core.test.mjs",
    "pack": "electron-packager . \"二游档案\" --platform=win32 --arch=x64 --out=dist --overwrite --asar=false --icon=public/icon.ico --ignore=dist --ignore=docs --ignore=tests --ignore=data/app.json --ignore=data/app.json.bak --ignore=data/backups --ignore=data/imports --ignore=data/nte-captures --ignore=data/uploads --ignore=data/assets --ignore=data/electron --ignore=scripts/pooltable.snippet.txt",
    "pack:release": "electron-packager . \"二游档案\" --platform=win32 --arch=x64 --out=dist/release-2.00 --overwrite --asar=false --icon=public/icon.ico --ignore=dist --ignore=docs --ignore=tests --ignore=data/app.json --ignore=data/app.json.bak --ignore=data/backups --ignore=data/imports --ignore=data/nte-captures --ignore=data/uploads --ignore=data/assets --ignore=data/electron --ignore=scripts/pooltable.snippet.txt"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.3.4"
  },
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/ichiryu0021/eryou-archive.git"
  },
  "productName": "二游档案",
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
